{
  "name": "@edgier/contracts",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy:creditcoin": "hardhat run scripts/deploy-creditcoin.ts --network cc3testnet",
    "settle:mainnet": "hardhat run scripts/settle-mainnet-incident.ts --network cc3testnet",
    "verify:bundle": "hardhat run scripts/verify-bundle-live.ts --network cc3testnet",
    "preflight": "tsx scripts/check-attestation.ts",
    "verify:live": "tsx scripts/verify-live.ts"
  },
  "dependencies": {
    "@gluwa/usc-sdk": "0.18.0",
    "@openzeppelin/contracts": "5.0.2",
    "dotenv": "16.6.1",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@types/node": "20.19.43",
    "hardhat": "2.29.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}

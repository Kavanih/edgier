# --- Source chain (Ethereum) ---
# Public, no API key needed. Swap in Infura/Alchemy if you hit rate limits.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# --- Creditcoin CC3 Testnet (EVM chainId 102031) ---
CC3_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# Two hosts serve the same proof generator; verify:live tries both.
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Attestcoin source chain ids (see docs: Chains - Environments)
#   1 = Ethereum Sepolia, 3 = Ethereum Mainnet  (as seen from CC3 Testnet)
CHAIN_KEY=1

# --- Keys (testnet only, never commit .env) ---
# Generate throwaways:
#   node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
# Fund the deployer from the Creditcoin Discord faucet — see docs/TESTNET.md.
DEPLOYER_PRIVATE_KEY=0x...
WATCHER_PRIVATE_KEY=0x...

# --- Deployed addresses (filled in by deploy scripts) ---
COVER_POOL_ADDRESS=
POLICY_MANAGER_ADDRESS=
CLAIM_VERIFIER_ADDRESS=
VULNERABLE_VAULT_ADDRESS=

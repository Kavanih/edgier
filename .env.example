# --- Source chain (the EVM chain policies are written against) ---
# 1 = Ethereum Sepolia, 3 = Ethereum Mainnet (Attestcoin chainKeys as seen from CC3 Testnet)
CHAIN_KEY=3
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional override; otherwise chosen from CHAIN_KEY above.
# SOURCE_RPC_URL=

# --- Creditcoin CC3 Testnet (EVM chainId 102031) ---
CC3_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# --- Keys (testnet only, never commit .env) ---
#   node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
# Fund the deployer from the Creditcoin Discord faucet — see docs/TESTNET.md.
DEPLOYER_PRIVATE_KEY=0x...
WATCHER_PRIVATE_KEY=0x...

# --- Deployed addresses (printed by npm run deploy:creditcoin) ---
COVER_POOL_ADDRESS=
POLICY_MANAGER_ADDRESS=
CLAIM_VERIFIER_ADDRESS=
# The EVM contract the watcher follows for new losses.
INSURED_CONTRACT_ADDRESS=

# --- AI sidecar (optional) ---
# Free OpenRouter models only; capped at OPENROUTER_DAILY_CAP calls a day.
OPENROUTER_API_KEY=
OPENROUTER_DAILY_CAP=900
AI_PORT=8787
